@using thuytrang.Web.Startup
@using thuytrang.Web.Models.Common.Modals
@{
    ViewBag.CurrentPageName = PageNames.Reviews;
}

@section scripts {
    <environment names="Development,Staging,Production">
        @* Đảm bảo load đúng thư viện cần thiết cho DataTable *@
        <script src="~/view-resources/Views/Review/Index.js" asp-append-version="true"></script>
    </environment>
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h1>Đánh giá</h1>
            </div>
            <div class="col-sm-6">
                <button type="button" class="btn btn-primary float-sm-right" data-toggle="modal" data-target="#ReviewCreateModal">
                    <i class="fa fa-plus-circle"></i> Thêm Đánh Giá
                </button>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    @* Quan trọng: ID phải khớp với file Index.js *@
                    <table id="ReviewsTable" class="table table-striped table-bordered nowrap">
                        <thead>
                            <tr>
                                <th>Nội dung</th>
                                <th>Đánh giá (Sao)</th>
                                <th>Trạng thái</th>
                                <th style="width: 150px">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>

@* Load Modal thêm mới *@
@await Html.PartialAsync("_CreateModal.cshtml")

@* Nơi chứa Modal chỉnh sửa khi bấm nút Sửa *@
<div id="ReviewEditModalContainer"></div>
<script src="~/view-resources/Views/Review/Index.js" asp-append-version="true"></script>
