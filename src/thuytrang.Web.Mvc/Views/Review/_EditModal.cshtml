@model thuytrang.Reviews.Dto.ReviewDto
<div class="modal fade" id="ReviewEditModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <form name="ReviewEditForm" role="form" class="form-horizontal">
                <input type="hidden" name="Id" value="@Model.Id" />
                <div class="modal-header">
                    <h5 class="modal-title">Chỉnh sửa Đánh giá</h5>
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                </div>
                <div class="modal-body">
                    <div class="form-group row required">
                        <label class="col-md-3 col-form-label">Tiêu đề</label>
                        <div class="col-md-9">
                            <input type="text" name="Title" class="form-control" required maxlength="255" value="@Model.Title" />
                        </div>
                    </div>
                    <div class="form-group row required">
                        <label class="col-md-3 col-form-label">Nội dung đánh giá</label>
                        <div class="col-md-9">
                            <textarea name="Content" class="form-control" required maxlength="1000">@Model.Content</textarea>
                        </div>
                    </div>
                    <div class="form-group row required">
                        <label class="col-md-3 col-form-label">Xếp hạng (1-5 sao)</label>
                        <div class="col-md-9">
                            <select name="Rating" class="form-control">
                                <option value="5" selected="@(Model.Rating == 5)">5 Sao - Rất tốt</option>
                                <option value="4" selected="@(Model.Rating == 4)">4 Sao - Tốt</option>
                                <option value="3" selected="@(Model.Rating == 3)">3 Sao - Bình thường</option>
                                <option value="2" selected="@(Model.Rating == 2)">2 Sao - Tệ</option>
                                <option value="1" selected="@(Model.Rating == 1)">1 Sao - Rất tệ</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group row">
                        <label class="col-md-3 col-form-label">Kích hoạt</label>
                        <div class="col-md-9">
                            <div class="custom-control custom-checkbox">
                                <input type="checkbox" name="IsActive" value="true" id="EditReviewIsActive" class="custom-control-input" checked="@Model.IsActive" />
                                <label class="custom-control-label" for="EditReviewIsActive"></label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer justify-content-between">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Hủy</button>
                    <button type="button" class="btn btn-primary save-button">Cập nhật</button>
                </div>
            </form>
        </div>
    </div>
</div> 
